PORT=3002
NODE_ENV=production
DATABASE_URL="sqlserver://sqlteste.franca.intranet:1433;database=db_acompanhamento_glpi;username=DOMINIO\\usuario;password={senha};encrypt=false;trustServerCertificate=true"
# Obrigatória em novas instalações; JWT_SECRET legado é aceito temporariamente.
SESSION_ENCRYPTION_KEY=substitua-por-uma-chave-aleatoria-com-ao-menos-32-caracteres
GLPI_URL=https://glpi.exemplo.gov.br/apirest.php
GLPI_APP_TOKEN=substitua-pelo-app-token-do-glpi
GLPI_ADMIN_IDS=1,2
# Active Directory usado para validar o login. O GLPI deve estar integrado ao
# mesmo AD para criar a sessão individual do usuário pela API.
AD_URL=ldap://controlador-dominio.franca.intranet:389
AD_BASE_DN=DC=franca,DC=intranet
AD_DOMAIN=FRANCA
FRONTEND_ORIGIN=https://sistemas.franca.sp.gov.br
AMBIENTE=HOMOLOGACAO
